# SeaSphere Environment Configuration
# Copy this file to .env and configure your secrets

# Database Configuration
# For local SQLite: sqlite:///data/seasphere.db
# For PostgreSQL (Render / Supabase / Neon / Local PostgreSQL):
# DATABASE_URL=postgresql://user:password@localhost:5432/seasphere
DATABASE_URL=sqlite:///data/seasphere.db

# Flask App Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=seasphere_sih_secure_secret_key_2026

# External API Keys (Optional - Free fallback providers configured)
# OPEN_METEO_API_KEY=
# COMMODITY_MARKET_API_KEY=
